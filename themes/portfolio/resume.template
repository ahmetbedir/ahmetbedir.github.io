<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{resume.basics.name}}{{#if resume.basics.label}} — {{resume.basics.label}}{{/if}}</title>
    <meta name="description" content="{{resume.basics.summary}}" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0%25' stop-color='%2338bdf8'/%3E%3Cstop offset='100%25' stop-color='%23818cf8'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='url(%23g)'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='sans-serif' font-size='26' font-weight='700'%3E{{initials resume.basics.name}}%3C/text%3E%3C/svg%3E" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{resume.basics.name}}{{#if resume.basics.label}} — {{resume.basics.label}}{{/if}}" />
    <meta property="og:description" content="{{resume.basics.summary}}" />
    {{#if resume.basics.url}}<meta property="og:url" content="{{resume.basics.url}}" />{{/if}}
    {{#if resume.basics.image}}<meta property="og:image" content="{{resume.basics.image}}" />{{/if}}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{resume.basics.name}}{{#if resume.basics.label}} — {{resume.basics.label}}{{/if}}" />
    <meta name="twitter:description" content="{{resume.basics.summary}}" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <script>
      (function () {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>

    <style>
      {{{css}}}
    </style>
    <script type="application/ld+json">{{{jsonLd}}}</script>
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>

    <nav class="navbar" aria-label="Primary">
      <div class="nav-inner">
        <a href="#top" class="brand">
          <span class="brand-badge">{{initials resume.basics.name}}</span>
          <span>{{#if resume.basics.url}}{{stripProtocol resume.basics.url}}{{else}}{{resume.basics.name}}{{/if}}</span>
        </a>

        <ul class="nav-links">
          {{#if resume.selectedWork.length}}<li><a href="#work">Work</a></li>{{/if}}
          <li><a href="#experience">Experience</a></li>
          {{#if resume.projects.length}}<li><a href="#projects">Projects</a></li>{{/if}}
          <li><a href="#skills">Skills</a></li>
          <li><a href="#education">Education</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>

        <div class="nav-actions">
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg class="icon-moon" style="display:none" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
          <a class="btn btn-primary btn-sm" href="resume/ahmetbedir.pdf" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Resume PDF
          </a>
        </div>
      </div>
    </nav>

    <main id="top" class="container">
      <header class="hero">
        <div class="hero-grid">
          <div>
            <div class="status-pill mono">
              <span class="status-dot" aria-hidden="true"></span>
              {{#if currentJob}}{{currentJob.position}} @ {{currentJob.name}}{{else}}{{resume.basics.label}}{{/if}}
              {{#if resume.basics.location}} · {{resume.basics.location.city}}, {{resume.basics.location.countryCode}}{{/if}}
            </div>

            <h1>{{resume.basics.name}}</h1>
            {{#if resume.basics.label}}
            <div class="hero-role">{{resume.basics.label}}</div>
            {{/if}}
            {{#if resume.basics.pitch}}
            <p class="hero-summary">{{resume.basics.pitch}}</p>
            {{else if resume.basics.summary}}
            <p class="hero-summary">{{resume.basics.summary}}</p>
            {{/if}}

            <div class="hero-actions">
              <a class="btn btn-primary" href="resume/ahmetbedir.pdf" download="Ahmet-Bedir-Resume.pdf">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download CV
              </a>

              {{#if resume.basics.email}}
              <button type="button" class="btn btn-secondary" data-copy-email="{{resume.basics.email}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span class="copy-label">Copy Email</span>
              </button>
              {{/if}}

              <div class="social-row">
                {{#each resume.basics.profiles}}
                <a class="icon-btn" href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="{{network}}" title="{{network}}">
                  {{#if (eq network "GitHub")}}
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  {{else if (eq network "LinkedIn")}}
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                  {{else}}
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg>
                  {{/if}}
                </a>
                {{/each}}
              </div>
            </div>
          </div>

          {{#if resume.basics.image}}
          <div class="avatar-wrap">
            <img class="avatar" src="{{resume.basics.image}}" alt="{{resume.basics.name}}" width="176" height="176" />
          </div>
          {{/if}}
        </div>

        <div class="bento-strip">
          <div class="bento-card">
            <div class="bento-label mono">Experience</div>
            <div class="bento-value">8+ Years</div>
            <div class="bento-sub">Engineering team lead</div>
          </div>
          <div class="bento-card">
            <div class="bento-label mono">Primary Stack</div>
            <div class="bento-value">PHP / Laravel</div>
            <div class="bento-sub">PostgreSQL · Redis · Horizon</div>
          </div>
          <div class="bento-card">
            <div class="bento-label mono">Focus</div>
            <div class="bento-value">90+ Integrations</div>
            <div class="bento-sub">Marketplaces · Carriers · AI tooling</div>
          </div>
          <div class="bento-card">
            <div class="bento-label mono">Location</div>
            <div class="bento-value">{{resume.basics.location.city}}, {{resume.basics.location.countryCode}}</div>
            <div class="bento-sub">Remote-friendly (UTC+3)</div>
          </div>
        </div>
      </header>

      {{#if resume.selectedWork.length}}
      <section id="work" class="section reveal">
        <div class="section-head">
          <div>
            <div class="section-kicker mono">01 / Selected Work</div>
            <h2 class="section-title">What I Build</h2>
          </div>
        </div>

        <div class="projects-grid">
          {{#each resume.selectedWork}}
          <article class="project-card case-card">
            <div>
              <div class="project-top">
                <span class="case-role mono">{{role}}</span>
                {{#if url}}
                <a class="case-link mono" href="{{url}}" target="_blank" rel="noopener noreferrer">{{stripProtocol url}} ↗</a>
                {{/if}}
              </div>
              <h3 class="project-name">{{name}}</h3>
              <p class="case-subtitle">{{subtitle}}</p>
              <dl class="case-steps">
                <dt class="mono">Problem</dt><dd>{{problem}}</dd>
                <dt class="mono">Approach</dt><dd>{{approach}}</dd>
                <dt class="mono">Outcome</dt><dd>{{outcome}}</dd>
              </dl>
            </div>
            {{#if keywords.length}}
            <ul class="tag-list">
              {{#each keywords}}
              <li class="tag mono">{{this}}</li>
              {{/each}}
            </ul>
            {{/if}}
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if resume.work.length}}
      <section id="experience" class="section reveal">
        <div class="section-head">
          <div>
            <div class="section-kicker mono">02 / Career</div>
            <h2 class="section-title">Work Experience</h2>
          </div>
        </div>

        <div class="timeline">
          {{#each resume.work}}
          <article class="timeline-item">
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class="work-top">
              <div>
                <h3 class="work-position">{{position}}</h3>
                {{#if url}}
                <a class="work-company" href="{{url}}" target="_blank" rel="noopener noreferrer">
                  {{name}}
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </a>
                {{else}}
                <div class="work-company">{{name}}</div>
                {{/if}}
              </div>
              <div class="work-meta mono">
                <span>{{formatDate startDate}} — {{formatDate endDate}}</span>
                <span>·</span>
                <span>{{formatDuration startDate endDate}}</span>
              </div>
            </div>

            {{#if summary}}
            <p class="work-summary">{{summary}}</p>
            {{/if}}

            {{#if highlights.length}}
            <ul class="highlights">
              {{#each highlights}}
              <li>{{this}}</li>
              {{/each}}
            </ul>
            {{/if}}
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if resume.projects.length}}
      <section id="projects" class="section reveal">
        <div class="section-head">
          <div>
            <div class="section-kicker mono">03 / Open Source</div>
            <h2 class="section-title">Featured Projects</h2>
          </div>
          <a class="mono" style="font-size:0.84rem;color:var(--accent)" href="https://github.com/ahmetbedir" target="_blank" rel="noopener noreferrer">
            All repos on GitHub →
          </a>
        </div>

        <div class="projects-grid">
          {{#each resume.projects}}
          <a class="project-card" href="{{url}}" target="_blank" rel="noopener noreferrer">
            <div>
              <div class="project-top">
                <span class="project-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </span>
                <svg class="project-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </div>
              <h3 class="project-name">{{name}}</h3>
              <p class="project-desc">{{description}}</p>
            </div>
            {{#if keywords.length}}
            <ul class="tag-list">
              {{#each keywords}}
              <li class="tag mono">{{this}}</li>
              {{/each}}
            </ul>
            {{/if}}
          </a>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if resume.skills.length}}
      <section id="skills" class="section reveal">
        <div class="section-head">
          <div>
            <div class="section-kicker mono">04 / Toolkit</div>
            <h2 class="section-title">Technical Skills</h2>
          </div>
        </div>

        <div class="skills-grid">
          {{#each resume.skills}}
          <div class="skill-card">
            <h3 class="skill-card-title">{{name}}</h3>
            {{#if keywords.length}}
            <ul class="tag-list">
              {{#each keywords}}
              <li class="tag mono">{{this}}</li>
              {{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}

      <section id="education" class="section reveal">
        <div class="section-head">
          <div>
            <div class="section-kicker mono">05 / Background</div>
            <h2 class="section-title">Education &amp; Languages</h2>
          </div>
        </div>

        <div class="edu-lang-grid">
          {{#if resume.education.length}}
          <div class="panel">
            <div class="panel-list">
              {{#each resume.education}}
              <div class="edu-item">
                <div>
                  <div class="edu-school">{{institution}}</div>
                  <div class="edu-degree">{{studyType}}{{#if area}} in {{area}}{{/if}}</div>
                </div>
                <div class="edu-date mono">{{formatDate startDate}} — {{formatDate endDate}}</div>
              </div>
              {{/each}}
            </div>
          </div>
          {{/if}}

          {{#if resume.languages.length}}
          <div class="panel">
            <div class="panel-list">
              {{#each resume.languages}}
              <div class="lang-item">
                <span class="lang-name">{{language}}</span>
                <span class="lang-level mono">{{fluency}}</span>
              </div>
              {{/each}}
            </div>
          </div>
          {{/if}}
        </div>
      </section>

      <section id="contact" class="section reveal">
        <div class="contact-card">
          <div class="contact-copy">
            <h2>Let's build something great.</h2>
            <p>Interested in discussing system architecture, full-stack engineering leadership, or SaaS opportunities? Reach out directly or download the ATS-ready PDF resume.</p>
          </div>
          <div class="contact-actions">
            {{#if resume.basics.email}}
            <a class="btn btn-primary" href="mailto:{{resume.basics.email}}">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Email Me
            </a>
            {{/if}}
            <a class="btn btn-secondary" href="resume/ahmetbedir.pdf" target="_blank" rel="noopener">
              View ATS PDF
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>© {{currentYear}} {{resume.basics.name}}. Built from <span class="mono">resume.json</span>.</div>
        <div class="footer-links">
          {{#each resume.basics.profiles}}
          <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{network}}</a>
          {{/each}}
          <a href="resume/ahmetbedir.pdf" target="_blank" rel="noopener">PDF Resume</a>
        </div>
      </div>
    </footer>

    <script>
      (function () {
        // Theme toggle
        var root = document.documentElement;
        var toggle = document.getElementById("theme-toggle");
        var sun = toggle && toggle.querySelector(".icon-sun");
        var moon = toggle && toggle.querySelector(".icon-moon");

        function syncIcons() {
          var isLight = root.getAttribute("data-theme") === "light";
          if (sun) sun.style.display = isLight ? "none" : "block";
          if (moon) moon.style.display = isLight ? "block" : "none";
        }
        syncIcons();

        if (toggle) {
          toggle.addEventListener("click", function () {
            var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
            root.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
            syncIcons();
          });
        }

        // Copy email button
        document.querySelectorAll("[data-copy-email]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var email = btn.getAttribute("data-copy-email");
            var label = btn.querySelector(".copy-label");
            if (!navigator.clipboard || !email) return;
            navigator.clipboard.writeText(email).then(function () {
              if (label) {
                label.textContent = "Copied!";
                setTimeout(function () {
                  label.textContent = "Copy Email";
                }, 1800);
              }
            });
          });
        });

        // Scroll reveal
        var reveals = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08 }
          );
          reveals.forEach(function (el) {
            observer.observe(el);
          });
        } else {
          reveals.forEach(function (el) {
            el.classList.add("visible");
          });
        }

        // Active nav link on scroll
        var navLinks = Array.from(document.querySelectorAll(".nav-links a"));
        var sections = navLinks
          .map(function (a) {
            return document.querySelector(a.getAttribute("href"));
          })
          .filter(Boolean);

        window.addEventListener(
          "scroll",
          function () {
            var y = window.scrollY + 120;
            var current = null;
            sections.forEach(function (sec) {
              if (sec.offsetTop <= y) current = sec.id;
            });
            navLinks.forEach(function (a) {
              a.classList.toggle("active", a.getAttribute("href") === "#" + current);
            });
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
